{
  "name": "gas-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "push": "gas-app push",
    "deploy": "gas-app deploy",
    "open": "gas-app open"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.2",
    "@google/clasp": "^3.4.1",
    "gas-app-kit": "^0.1.2",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.69.0",
    "globals": "^17.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
